<?php
session_start();
// Enable error reporting for debugging
ini_set('display_errors', 1);
ini_set('display_startup_errors', 1);
error_reporting(E_ALL);
// Set default timezone
date_default_timezone_set('Europe/Warsaw');
// Database connection
try {
    $db = new PDO('sqlite:access.db');
    $db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
    // Check and add background_image column if not exists
    $columns = $db->query("PRAGMA table_info(users)")->fetchAll(PDO::FETCH_ASSOC);
    $hasBackgroundColumn = false;
    foreach ($columns as $column) {
        if ($column['name'] === 'background_image') $hasBackgroundColumn = true;
    }
    if (!$hasBackgroundColumn) {
        $db->exec("ALTER TABLE users ADD COLUMN background_image TEXT");
    }
} catch (PDOException $e) {
    die("Database Error: " . $e->getMessage());
}
// Redirect to login.php if not logged in
if (!isset($_SESSION['user_id'])) {
    header("Location: login.php");
    exit;
}
// Handle image upload and conversion
$error = '';
$success = '';
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_FILES['image'])) {
    $targetDir = "uploads/";
    $allowedTypes = ['image/jpeg', 'image/png', 'image/bmp'];
    $maxFileSize = 5 * 1024 * 1024; // 5MB

    // Validate file
    if (!in_array($_FILES['image']['type'], $allowedTypes)) {
        $error = "Invalid file type. Only JPEG, PNG, and BMP are allowed.";
    } elseif ($_FILES['image']['size'] > $maxFileSize) {
        $error = "File size exceeds 5MB limit.";
    } elseif ($_FILES['image']['error'] !== UPLOAD_ERR_OK) {
        $error = "Upload error: " . $_FILES['image']['error'];
    } else {
        // Ensure uploads directory exists
        if (!is_dir($targetDir)) {
            mkdir($targetDir, 0755, true);
        }

        // Generate unique filename
        $access_code = $_SESSION['access_code'];
        $filename = $access_code . '_background.bin';
        $outputFile = $targetDir . $filename;

        // Load and resize image
        $sourceImage = null;
        switch ($_FILES['image']['type']) {
            case 'image/jpeg':
                $sourceImage = imagecreatefromjpeg($_FILES['image']['tmp_name']);
                break;
            case 'image/png':
                $sourceImage = imagecreatefrompng($_FILES['image']['tmp_name']);
                break;
            case 'image/bmp':
                $sourceImage = imagecreatefrombmp($_FILES['image']['tmp_name']);
                break;
        }

        if ($sourceImage === false) {
            $error = "Failed to load image.";
        } else {
            // Resize to 800x480
            // $width = 800;
            //$height = 480;
            // resize half
            $width = 400;
            $height = 240;
            $resizedImage = imagecreatetruecolor($width, $height);
            imagecopyresampled($resizedImage, $sourceImage, 0, 0, 0, 0, $width, $height, imagesx($sourceImage), imagesy($sourceImage));

            // Convert to raw RGB888 format
            $rawData = '';
            for ($y = 0; $y < $height; $y++) {
                for ($x = 0; $x < $width; $x++) {
                    $rgb = imagecolorat($resizedImage, $x, $y);
                    $colors = imagecolorsforindex($resizedImage, $rgb);
                    $rawData .= chr($colors['red']) . chr($colors['green']) . chr($colors['blue']);
                }
            }

            // Save raw data to file
            if (file_put_contents($outputFile, $rawData) !== false) {
                // Update database
                $stmt = $db->prepare("UPDATE users SET background_image = ? WHERE access_code = ?");
                $stmt->execute([$filename, $access_code]);
                $success = "Image converted and saved. Access it at: " . $_SERVER['HTTP_HOST'] . "/$targetDir" . $filename;
            } else {
                $error = "Failed to save converted image.";
            }

            // Clean up
            imagedestroy($sourceImage);
            imagedestroy($resizedImage);
        }
    }
}
?>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
